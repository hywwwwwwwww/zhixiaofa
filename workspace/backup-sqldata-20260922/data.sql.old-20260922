-- ---------------------------------------------------------------- 5. court_case 小法庭案件
INSERT INTO `court_case` (`id`,`user_id`,`title`,`description`,`case_type`,`win_probability`,`compensation_min`,`compensation_max`,`similar_count`,`result_summary`,`created_at`) VALUES
(1,2,'公司以“试用期不合格”为由辞退我','入职2个月，无任何考核记录，HR口头通知我第二天不用来了，未出具书面文件。','违法辞退','78.50',8000,24000,36,'同类案件中约78.5%被认定违法解除，可主张赔偿金2N。','2026-08-21 21:40:00'),
(2,3,'拖欠工资3个月共4.2万元','公司连续3个月未发工资，仅以经营困难为由拖延，未签补充协议。','拖欠工资','92.30',42000,63000,52,'拖欠劳动报酬事实清楚的，支持率高，另可主张经济补偿。','2026-08-11 14:54:00'),
(3,4,'离职后公司不发最后一个月工资','9月正常出勤至20日离职，公司以“未交接完成”拒发当月工资。','拖欠工资','88.00',6000,9000,41,'离职当月工资应按实际出勤结算，拒发缺乏依据。','2026-08-21 16:30:00'),
(4,5,'长期加班无加班费','近一年平均每月加班40小时，公司无调休也未支付加班费。','加班费','74.20',15000,45000,29,'需举证加班事实，考勤与工作记录是关键。','2026-08-25 13:35:00'),
(5,6,'入职1年未缴社保','公司称试用期后缴，实际一年未办理社保登记。','社保','85.60',0,0,33,'可要求补缴，并据此解除合同主张经济补偿。','2026-08-13 11:08:00'),
(6,7,'未签书面劳动合同11个月','入职起从未签订劳动合同，每月正常发薪。','其他','90.10',33000,55000,47,'可主张未签合同期间的二倍工资差额。','2026-08-04 16:35:00'),
(7,8,'单方调岗降薪30%','公司未经协商将我从技术岗调至客服岗，薪资下调30%。','违法辞退','76.80',12000,36000,25,'调岗降薪需协商一致，劳动者可拒绝。','2026-08-11 10:34:00'),
(8,9,'竞业限制约定但未付补偿','离职后公司要求遵守竞业限制，但三个月未支付任何补偿。','其他','83.40',9000,27000,19,'可请求解除竞业限制约定并要求已履行期间补偿。','2026-08-22 17:22:00'),
(9,10,'强制休假抵扣年假','公司春节统一放假15天，其中10天从年假中扣除。','其他','65.30',3000,8000,14,'法定节假日与公司统一放假不应冲抵年假。','2026-08-01 20:04:00'),
(10,11,'女职工孕期被辞退','确认怀孕后一周被通知“岗位取消”，实际该岗位仍在招聘。','违法辞退','94.70',24000,72000,22,'孕期、产期、哺乳期内用人单位不得随意解除。','2026-08-04 20:27:00');

