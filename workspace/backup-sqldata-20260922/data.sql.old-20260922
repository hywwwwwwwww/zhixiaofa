-- ---------------------------------------------------------------- 13. quiz_question 自测题
INSERT INTO `quiz_question` (`id`,`category`,`question`,`option_a`,`option_b`,`option_c`,`option_d`,`correct_option`,`explanation`,`difficulty`) VALUES
(1,'试用期','劳动合同期限为2年的，试用期最长不得超过多久？','1个月','2个月','3个月','6个月','B','《劳动合同法》第十九条：1年以上不满3年的，试用期不得超过2个月。',1),
(2,'工资报酬','法定节假日安排加班，应支付不低于工资的多少倍？','1.5倍','2倍','3倍','4倍','C','《劳动法》第四十四条第三项规定为不低于300%。',2),
(3,'劳动合同','用人单位自用工之日起超过一个月不满一年未签书面劳动合同，应向劳动者每月支付几倍工资？','1倍','1.5倍','2倍','3倍','C','《劳动合同法》第八十二条规定的二倍工资。',1),
(4,'解除终止','用人单位违法解除劳动合同，应支付的赔偿金标准是？','N','N+1','2N','3N','C','《劳动合同法》第八十七条：按第四十七条标准的二倍支付。',2),
(5,'社会保险','用人单位应在用工之日起多少日内为职工办理社保登记？','15日','30日','60日','90日','B','《社会保险法》第五十八条规定的30日。',2),
(6,'工资报酬','休息日安排加班又不能安排补休的，应支付不低于工资的？','1.5倍','2倍','3倍','2.5倍','B','《劳动法》第四十四条第二项。',1),
(7,'解除终止','劳动者试用期内辞职，应提前多久通知用人单位？','3日','7日','15日','30日','A','《劳动合同法》第三十七条：试用期内提前三日通知。',1),
(8,'竞业限制','竞业限制期限最长不得超过？','1年','2年','3年','5年','B','《劳动合同法》第二十四条规定的二年。',1),
(9,'其他','劳动争议申请仲裁的一般时效期间是？','6个月','1年','2年','3年','B','《劳动争议调解仲裁法》第二十七条。',1),
(10,'劳动合同','同一用人单位与同一劳动者可以约定几次试用期？','1次','2次','3次','不限次数','A','《劳动合同法》第十九条：只能约定一次试用期。',1),
(11,'工资报酬','试用期工资不得低于劳动合同约定工资的？','50%','60%','70%','80%','D','《劳动合同法》第二十条：不得低于约定工资的80%。',2),
(12,'解除终止','用人单位未及时足额支付劳动报酬的，劳动者可以？','只能等待','解除劳动合同并主张经济补偿','必须先申请仲裁才能离职','无权解除','B','《劳动合同法》第三十八条规定的即时解除权。',3);

