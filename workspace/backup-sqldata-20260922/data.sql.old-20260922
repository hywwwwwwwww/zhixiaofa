-- ---------------------------------------------------------------- 7. contract_risk 合同风险点
INSERT INTO `contract_risk` (`id`,`contract_id`,`risk_level`,`clause_no`,`clause_content`,`risk_desc`,`suggestion`,`law_id`,`created_at`) VALUES
(1,1,'高','第8条','甲方可根据经营需要单方调整乙方岗位及工作地点，乙方不得拒绝。','单方调岗条款排除劳动者协商权，属无效条款。','改为“经双方协商一致可变更岗位及工作地点”，并约定变更需书面确认。',1,'2026-06-18 10:02:00'),
(2,1,'高','第12条','乙方离职后2年内不得从事同行业工作，甲方无需支付经济补偿。','竞业限制不支付补偿，条款对劳动者不生效。','约定竞业限制期限不超过2年，并按月支付不低于离职前12个月平均工资30%的补偿。',10,'2026-06-19 10:59:00'),
(3,1,'高','第15条','乙方自愿放弃参加社会保险，由甲方每月发放社保补贴500元。','社保为法定义务，不可通过约定放弃，该约定无效。','删除该条，依法为员工办理五险登记并足额缴纳。',13,'2026-08-17 10:52:00'),
(4,2,'高','第12条','乙方离职后2年内不得从事同行业工作，甲方无需支付经济补偿。','竞业限制不支付补偿，条款对劳动者不生效。','约定竞业限制期限不超过2年，并按月支付不低于离职前12个月平均工资30%的补偿。',10,'2026-07-12 10:35:00'),
(5,2,'高','第15条','乙方自愿放弃参加社会保险，由甲方每月发放社保补贴500元。','社保为法定义务，不可通过约定放弃，该约定无效。','删除该条，依法为员工办理五险登记并足额缴纳。',13,'2026-07-06 10:15:00'),
(6,3,'高','第15条','乙方自愿放弃参加社会保险，由甲方每月发放社保补贴500元。','社保为法定义务，不可通过约定放弃，该约定无效。','删除该条，依法为员工办理五险登记并足额缴纳。',13,'2026-06-10 10:26:00'),
(7,4,'中','第6条','加班费按月固定发放500元，超出部分不再另行计算。','固定加班费包干可能低于法定标准。','改为按实际加班时长依据《劳动法》第四十四条标准据实计算。',12,'2026-08-01 10:02:00'),
(8,4,'中','第9条','乙方在试用期内离职的，需支付违约金2000元。','除服务期和竞业限制情形外，约定劳动者承担违约金无法律依据。','删除该违约金条款。',3,'2026-07-16 10:20:00'),
(9,4,'中','第11条','甲方可依据内部规章制度对乙方进行罚款。','用人单位无罚款权，扣减工资需有法律依据。','删除罚款条款，改为绩效管理与考核机制。',11,'2026-07-03 10:45:00'),
(10,4,'中','第4条','工资于次月30日发放。','发薪日过晚，易被认定为拖欠工资。','建议调整为次月15日前发放，并明确遇节假日的提前发放规则。',7,'2026-08-07 10:26:00'),
(11,5,'中','第9条','乙方在试用期内离职的，需支付违约金2000元。','除服务期和竞业限制情形外，约定劳动者承担违约金无法律依据。','删除该违约金条款。',3,'2026-08-16 10:11:00'),
(12,5,'中','第11条','甲方可依据内部规章制度对乙方进行罚款。','用人单位无罚款权，扣减工资需有法律依据。','删除罚款条款，改为绩效管理与考核机制。',11,'2026-06-16 10:41:00'),
(13,7,'中','第4条','工资于次月30日发放。','发薪日过晚，易被认定为拖欠工资。','建议调整为次月15日前发放，并明确遇节假日的提前发放规则。',7,'2026-07-02 10:34:00'),
(14,7,'低','第5条','工作时间实行标准工时制，每日8小时。','条款本身合规，建议补充加班审批流程。','补充“加班需经审批，未经审批的自愿延时不计加班”。',12,'2026-06-03 10:54:00'),
(15,8,'低','第5条','工作时间实行标准工时制，每日8小时。','条款本身合规，建议补充加班审批流程。','补充“加班需经审批，未经审批的自愿延时不计加班”。',12,'2026-07-22 10:59:00'),
(16,9,'低','第7条','乙方应遵守甲方依法制定的规章制度。','表述合规，建议将规章制度作为附件一并签署。','将员工手册作为合同附件，签署确认页。',6,'2026-06-06 10:29:00'),
(17,9,'高','第3条','试用期为6个月，试用期工资为转正工资的60%。','试用期过长且试用期工资低于法定下限（约定工资的80%）。','试用期调整为不超过法定期限，试用期工资不得低于转正工资的80%，且不低于当地最低工资标准。',2,'2026-06-20 10:59:00'),
(18,9,'高','第8条','甲方可根据经营需要单方调整乙方岗位及工作地点，乙方不得拒绝。','单方调岗条款排除劳动者协商权，属无效条款。','改为“经双方协商一致可变更岗位及工作地点”，并约定变更需书面确认。',1,'2026-08-23 10:31:00'),
(19,10,'高','第3条','试用期为6个月，试用期工资为转正工资的60%。','试用期过长且试用期工资低于法定下限（约定工资的80%）。','试用期调整为不超过法定期限，试用期工资不得低于转正工资的80%，且不低于当地最低工资标准。',2,'2026-07-23 10:05:00'),
(20,10,'高','第8条','甲方可根据经营需要单方调整乙方岗位及工作地点，乙方不得拒绝。','单方调岗条款排除劳动者协商权，属无效条款。','改为“经双方协商一致可变更岗位及工作地点”，并约定变更需书面确认。',1,'2026-07-07 10:51:00');

