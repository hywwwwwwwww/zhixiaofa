# ============================================================================
#  数据库连接配置 · 外部覆盖文件（示例模板）
#  ---------------------------------------------------------------------------
#  用法：
#    1. 复制本文件并去掉 .example 后缀 → config/db.properties
#    2. 把下面的账号密码改成你自己 MySQL 的值
#    3. 重启应用生效（本文件覆盖 classpath 里的默认 db.properties）
#
#  ⚠️ config/db.properties 已在 .gitignore 中忽略，因为里面有数据库密码。
#     本示例文件只保留字段名，**绝不要**把真实密码写进本文件或提交到仓库。
#
#  【先建库】在项目根执行（schema.sql 会先 DROP 同名库，别指向已有数据的库）：
#      mysql -u root -p < sql/schema.sql
#      mysql -u root -p zhixiaofa < sql/data.sql
#      mysql -u root -p zhixiaofa < sql/migration-20260923-email-verify.sql
#
#  【只想改密码】本文件只需写要覆盖的键，其余键自动沿用 classpath 默认值。
# ============================================================================

# ---------- JDBC 基本参数 ----------
jdbc.url=jdbc:mysql://127.0.0.1:3306/zhixiaofa?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
jdbc.username=root
jdbc.password=

# ---------- 连接池参数（不写则用默认值） ----------
# pool.minIdle=2
# pool.maxTotal=20
# pool.maxWaitMillis=5000
# pool.maxIdleMillis=300000
# pool.validationQuery=SELECT 1

# ---------- 业务参数（不写则用默认值） ----------
# page.defaultSize=10
# page.maxSize=100
