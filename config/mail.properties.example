# ============================================================================
#  邮件（SMTP）配置 · 外部覆盖文件（示例模板）
#  ---------------------------------------------------------------------------
#  用法：
#    1. 复制本文件并去掉 .example 后缀 → config/mail.properties
#    2. 填写 mail.username / mail.password / mail.from
#    3. 本文件优先级高于 src/main/resources/mail.properties，改完需重启应用。
#
#  ⚠️ config/mail.properties 已在 .gitignore 中忽略，因为里面有 SMTP 授权码。
#     本示例文件只保留字段名，**绝不要**把真实授权码写进本文件或提交到仓库。
#
#  【怎么拿到授权码】（以 QQ 邮箱为例，163 流程类似）
#    1. 网页登录邮箱 → 设置 → 账号 → 找到「POP3/IMAP/SMTP…服务」，开启 SMTP 服务
#       （开之前要先绑定手机号，并过一次短信验证）
#    2. 在同一页面点「生成授权码」，把得到的 16 位字符串（不是登录密码！）填到下方
#    3. mail.username 与 mail.from 都填你自己的邮箱地址
#       —— QQ / 163 会校验信封发信人与登录账号一致，不一致直接 550 拒信
#
#  【验证是否配好】走一次「找回密码」最快：
#    登录页 → 忘记密码 → 填邮箱 → 收信。发不出去时后台日志会打出 SMTP 响应码，
#    535 = 授权码错，550 = 发信地址不一致 / 收件人不存在，超时 = 端口或网络被挡。
#
#  【注意】只支持 465 端口（隐式 SSL）。587 的 STARTTLS 没有实现，填了会握手失败。
# ============================================================================

# 总开关。false 时找回密码接口直接返回「邮件服务未启用」，其余功能完全不受影响。
# 四项凭证（host / username / password / from）任意一项为空，效果等同于 false。
mail.enabled=true

# SMTP 服务器地址与端口。QQ: smtp.qq.com ｜ 163: smtp.163.com ｜ Gmail: smtp.gmail.com
mail.host=smtp.qq.com
mail.port=465

# ★ 在这里填入发信账号与 SMTP 授权码（不是邮箱登录密码）
mail.username=
mail.password=

# 信封发信人。留空则取 mail.username
mail.from=

# 收件人看到的发件人显示名，同时用作邮件主题的前缀
mail.fromName=职小法

# 建连与单次读响应超时（毫秒）。
mail.connectTimeoutMs=8000
mail.readTimeoutMs=8000
